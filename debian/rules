#!/usr/bin/make -f

export DH_VERBOSE = 1

# Keep cargo's scratch state inside debian/ so the source tree stays clean.
export CARGO_HOME = $(CURDIR)/debian/cargo
export CARGO_TARGET_DIR = $(CURDIR)/target

CARGO_FLAGS = --release --locked

# A vendored registry (see README, "Building the Debian package") lets the
# build run with no network access, as an official Debian build requires.
ifneq (,$(wildcard $(CURDIR)/vendor))
CARGO_FLAGS += --offline
export CARGO_NET_OFFLINE = true
endif

DESTDIR = debian/telegram-notifier

# dpkg-buildpackage starts every run with `debian/rules clean`, which deletes
# $(CARGO_TARGET_DIR). Compiling the dependency tree takes minutes, so it is
# easy to launch a second build while the first is still going: the second
# one's clean then removes the target directory underneath the running cargo,
# which dies with a shower of unexplained ENOENT errors. Serialise build,
# test and clean behind an advisory lock on this file -- it always exists and
# is never written during a build, so it needs no cleanup of its own -- and
# report the real problem instead. flock(1) is in util-linux, which is
# Essential, so this needs no extra build dependency.
define exclusively
	@exec 9< $(CURDIR)/debian/rules; \
	flock --nonblock 9 || { \
	  echo "debian/rules: another build or clean is already running in" >&2; \
	  echo "debian/rules: $(CURDIR) -- wait for it to finish, then retry." >&2; \
	  exit 2; \
	}; \
	$(1)
endef

%:
	dh $@

# This tree is built with cargo directly, not through a debhelper buildsystem.
override_dh_auto_configure:

override_dh_auto_build:
	$(call exclusively,cargo build $(CARGO_FLAGS))

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(call exclusively,cargo test $(CARGO_FLAGS))
endif

override_dh_auto_install:
	install -D -m 0755 target/release/telegram-notifierd $(DESTDIR)/usr/bin/telegram-notifierd
	install -D -m 0755 target/release/telegram-notify    $(DESTDIR)/usr/bin/telegram-notify
	install -D -m 0640 conf/config.toml                   $(DESTDIR)/etc/telegram-notifier/config.toml
	install -D -m 0755 examples/notify-on-failure \
	  $(DESTDIR)/usr/share/telegram-notifier/examples/notify-on-failure
	install -D -m 0644 examples/telegram-notify-failure@.service \
	  $(DESTDIR)/usr/share/telegram-notifier/examples/telegram-notify-failure@.service
	install -D -m 0644 examples/logging-hook.sh \
	  $(DESTDIR)/usr/share/telegram-notifier/examples/logging-hook.sh
	install -D -m 0755 examples/send.py \
	  $(DESTDIR)/usr/share/telegram-notifier/examples/send.py
	install -D -m 0755 examples/notify-lifecycle \
	  $(DESTDIR)/usr/share/telegram-notifier/examples/notify-lifecycle
	install -D -m 0644 examples/telegram-notify-lifecycle.service \
	  $(DESTDIR)/usr/share/telegram-notifier/examples/telegram-notify-lifecycle.service

override_dh_auto_clean:
	$(call exclusively,rm -rf target debian/cargo)

# The release profile strips already, so dh_dwz has no debug info to process.
override_dh_dwz:

# A fresh install has no token and no chat id, so the unit must not be enabled
# behind the operator's back; postinst says what to do next. --no-start is
# deliberately absent: deb-systemd-invoke will not start a disabled unit, so a
# first install still stays quiet, while an upgrade restarts a unit the
# operator did enable -- otherwise it would keep running the old binary with
# no hint that it had gone stale.
override_dh_installsystemd:
	dh_installsystemd --no-enable

# dh_fixperms would make the configuration world-readable, and it may hold the
# bot token inline.
override_dh_fixperms:
	dh_fixperms --exclude etc/telegram-notifier/config.toml
